#!/usr/bin/env bash
#
# week — everything an issue of This Week in Modus is made of.
#
#   bin/week 2026-08-22          the issue dated that Saturday: 15–21 Aug
#   bin/week 2026-08-22 --log    ... and every commit subject, grouped by repo
#   bin/week 2026-08-22 --branches   the same week read across every ref
#   bin/week --list              every week of the project, numbered
#
# An issue dated Saturday S covers the seven days [S-7, S).  The workspace is
# the parent of this repo unless MODUS_WORKSPACE says otherwise.  The site's own
# repo is never counted: a dispatch does not report on itself.
#
# Line counts exclude generated acceptance-gate artefacts and committed scratch
# dumps, which in a bad week
# are 790,000 insertions of machine-written Lisp and would drown everything else.

set -o pipefail

ROOT="${MODUS_WORKSPACE:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
SELF=modus-lisp.github.io
NOISE='shards-jit|shards-off|real-ansi-gen|gate-net[.]out|[[:blank:]]scratch/'

die()   { printf 'week: %s\n' "$*" >&2; exit 1; }
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; exit "${1:-0}"; }

repos() { for d in "$ROOT"/*/; do r=$(basename "$d"); [ -e "$d/.git" ] || continue
            [ "$r" = "$SELF" ] && continue; echo "$r"; done; }

# The ref a week is counted on: the repository's default branch, whatever is
# checked out.  Not HEAD — a repo sitting on a feature branch would otherwise
# report that branch's work as the week's, or (if the branch is behind) report
# nothing.  Not origin/… either: work merged to main and not yet pushed is
# ordinary lag on a weekly publication, and belongs in the week it was merged.
mainref() {
  local r="$1" b
  for b in main master; do
    git -C "$ROOT/$r" rev-parse --verify -q "refs/heads/$b" >/dev/null && { echo "$b"; return; }
  done
  echo HEAD
}

# Commits whose AUTHOR date falls in [since, until).  git's own --since/--until
# read the committer date, which a rebase or a history rewrite resets to the day
# of the rewrite — so a week's work would land in whatever week it was replayed.
in_week() { git -C "$ROOT/$1" log "$(mainref "$1")" ${4:+"$4"} --format='%ad %H' --date=short |
              awk -v s="$2" -v u="$3" '$1 >= s && $1 < u {print $2}'; }

# ---------------------------------------------------------------- --list

list_weeks() {
  { for r in $(repos); do git -C "$ROOT/$r" log --format='%ad' --date=short; done; } |
  python3 -c '
import sys, datetime, collections
c = collections.Counter()
for line in sys.stdin:
    d = datetime.date.fromisoformat(line.strip())
    slip = (5 - d.weekday()) % 7          # days to the next Saturday
    c[d + datetime.timedelta(days=slip or 7)] += 1
for i, w in enumerate(sorted(c), 1):
    s = w - datetime.timedelta(days=7)
    print(f"{i:3d}  {w}  {s:%-d %b}–{w - datetime.timedelta(days=1):%-d %b %Y}  {c[w]:5d} commits")'
}

# ---------------------------------------------------------------- a week

week() {
  local until="$1" log="$2" since
  since=$(python3 -c "
import datetime,sys
d=datetime.date.fromisoformat('$until')
if d.weekday()!=5: sys.exit('week: %s is a %s, not a Saturday' % (d, d.strftime('%A')))
print(d-datetime.timedelta(days=7))") || exit 1

  printf 'ISSUE %s   covering %s .. %s (exclusive), by author date\n\n' "$until" "$since" "$until"
  printf '%-18s %7s %7s %9s %9s\n' REPO COMMITS FILES ADDED DELETED
  printf -- '---------------------------------------------------------\n'

  local total=0 moved=0
  for r in $(repos); do
    local all work n
    all=$(in_week "$r" "$since" "$until" "")
    [ -z "$all" ] && continue
    n=$(printf '%s\n' "$all" | wc -l | tr -d ' ')
    total=$((total + n)); moved=$((moved + 1))
    work=$(in_week "$r" "$since" "$until" --no-merges)
    if [ -n "$work" ]; then
      git -C "$ROOT/$r" log --no-walk --numstat --format='' $work | grep -vE "$NOISE" |
        awk -F'\t' -v r="$r" -v n="$n" '$1 ~ /^[0-9]+$/ {a+=$1; d+=$2; f[$3]=1}
          END {c=0; for (x in f) c++; printf "%-18s %7s %7d %9d %9d\n", r, n, c, a, d}'
    else
      printf '%-18s %7s %7d %9d %9d\n' "$r" "$n" 0 0 0
    fi
  done
  printf -- '---------------------------------------------------------\n'
  printf '%-18s %7d across %d repositories\n' TOTAL "$total" "$moved"

  offhead "$since" "$until"
  uncloned "$since" "$until"

  [ -n "$log" ] || return 0
  for r in $(repos); do
    local h; h=$(in_week "$r" "$since" "$until" "")
    [ -z "$h" ] || { printf '\n######## %s (%s)\n' "$r" "$(printf '%s\n' "$h" | wc -l | tr -d ' ')"
                     git -C "$ROOT/$r" log --no-walk --format='  %ad %h %s' --date=short $h; }
  done
}

# Commits in the window that exist in the repository but are not on its default
# branch: work on an unmerged branch.  The table counts the default branch,
# which is the right thing to count — an issue reports what landed — but a week
# can be badly misread if nobody says the branch is there.  This was written
# after a week in which modus sat on a feature branch and the table, then
# reading HEAD, reported that the project's central repository did nothing.
offhead() {
  local since="$1" until="$2" any=""
  for r in $(repos); do
    local head all off
    head=$(in_week "$r" "$since" "$until" "" | sort -u)
    all=$(git -C "$ROOT/$r" log --all --format='%ad %H' --date=short 2>/dev/null |
            awk -v s="$since" -v u="$until" '$1 >= s && $1 < u {print $2}' | sort -u)
    off=$(comm -13 <(printf '%s\n' "$head") <(printf '%s\n' "$all") | grep -c . )
    [ "${off:-0}" -gt 0 ] || continue
    [ -n "$any" ] || { printf '\nNOT COUNTED ABOVE — in the repo, not on the checked-out branch:\n'; any=1; }
    printf '  %-16s %3d commit(s) not on %s: ' "$r" "$off" "$(mainref "$r")"
    for b in $(git -C "$ROOT/$r" for-each-ref --format='%(refname:short)' refs/remotes refs/heads); do
      local n
      n=$(git -C "$ROOT/$r" log "$b" --format='%ad %H' --date=short 2>/dev/null |
            awk -v s="$since" -v u="$until" '$1 >= s && $1 < u {print $2}' | sort -u |
            comm -13 <(printf '%s\n' "$head") - | grep -c .)
      [ "${n:-0}" -gt 0 ] && printf '%s(%d) ' "$b" "$n"
    done
    printf '\n'
  done
  [ -n "$any" ] && printf '  Run with --branches to list them.\n'
  return 0
}

# Repositories that exist in the organisation but not in this workspace.  The
# ledger walks directories, so a repo nobody cloned is not a quiet week — it is
# an invisible one.  cl-payments was created and taken to a working Lightning
# node inside the week of 2026-09-05, and the first draft of that issue did not
# mention it, because it was never on this disk.  Needs `gh`; silent without it.
uncloned() {
  local since="$1" until="$2" listed any=""
  command -v gh >/dev/null 2>&1 || return 0
  listed=$(gh api -X GET /orgs/modus-lisp/repos --paginate -f per_page=100 \
             --jq '.[].name' 2>/dev/null) || return 0
  [ -n "$listed" ] || return 0
  while read -r r; do
    [ -z "$r" ] && continue
    [ "$r" = "$SELF" ] && continue
    [ -e "$ROOT/$r/.git" ] && continue
    local n
    n=$(gh api "/repos/modus-lisp/$r/commits?since=${since}T00:00:00Z&until=${until}T00:00:00Z&per_page=100" \
          --jq 'length' 2>/dev/null) || continue
    [ "${n:-0}" -gt 0 ] || continue
    [ -n "$any" ] || { printf '\nNOT COUNTED ABOVE — in the org, not cloned here:\n'; any=1; }
    printf '  %-16s %3d commit(s)   git clone git@github.com:modus-lisp/%s\n' "$r" "$n" "$r"
  done <<< "$listed"
  return 0
}

# --branches: the same week, read across every ref rather than the checkout.
branches_log() {
  local until="$1" since
  since=$(python3 -c "
import datetime
print(datetime.date.fromisoformat('$until')-datetime.timedelta(days=7))")
  printf 'ISSUE %s   covering %s .. %s — ALL REFS, not just the checkout\n' "$until" "$since" "$until"
  for r in $(repos); do
    local h
    h=$(git -C "$ROOT/$r" log --all --format='%ad %H' --date=short 2>/dev/null |
          awk -v s="$since" -v u="$until" '$1 >= s && $1 < u {print $2}' | sort -u)
    [ -z "$h" ] && continue
    printf '\n######## %s (%s)\n' "$r" "$(printf '%s\n' "$h" | wc -l | tr -d ' ')"
    git -C "$ROOT/$r" log --no-walk --format='  %ad %h %d %s' --date=short $h
  done
}

case "${1:-}" in
  ''|-h|--help) usage 0 ;;
  --list)       list_weeks ;;
  *)            [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "expected a Saturday (YYYY-MM-DD) or --list"
                if [ "${2:-}" = --branches ]; then branches_log "$1"; else week "$1" "${2:-}"; fi ;;
esac
