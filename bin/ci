#!/usr/bin/env python3
"""ci — the last CI run for every repository in the org, worst first.

    bin/ci              every repo
    bin/ci --bad        only what is failing or has no CI at all
    bin/ci --org other  a different org

Needs `gh` authenticated.  A repo with no Actions workflow is reported as
"none" rather than omitted: an absent gate and a green gate are very
different states, and only one of them is good news.
"""
import json, subprocess, sys, datetime

ORG = "modus-lisp"
argv = sys.argv[1:]
if "--org" in argv:
    ORG = argv[argv.index("--org") + 1]
BAD_ONLY = "--bad" in argv

def gh(path):
    r = subprocess.run(["gh", "api", path], capture_output=True, text=True)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None

def age(iso):
    d = datetime.datetime.fromisoformat(iso.replace("Z", "+00:00"))
    s = (datetime.datetime.now(datetime.timezone.utc) - d)
    if s.days >= 1:   return f"{s.days}d"
    if s.seconds >= 3600: return f"{s.seconds // 3600}h"
    return f"{max(s.seconds // 60, 1)}m"

repos = []
page = 1
while True:
    batch = gh(f"/orgs/{ORG}/repos?per_page=100&page={page}") or []
    if not batch: break
    repos += [r["name"] for r in batch if not r.get("archived")]
    page += 1

rows = []
for name in sorted(repos):
    runs = gh(f"/repos/{ORG}/{name}/actions/runs?per_page=1")
    wr = (runs or {}).get("workflow_runs") or []
    if not wr:
        rows.append((name, "none", "", "", "", ""))
        continue
    r = wr[0]
    rows.append((name, r.get("conclusion") or r.get("status") or "?",
                 age(r["created_at"]), (r.get("name") or "")[:20],
                 r.get("head_branch") or "", r.get("html_url") or ""))

RANK = {"failure": 0, "timed_out": 0, "cancelled": 1, "startup_failure": 0,
        "in_progress": 2, "queued": 2, "none": 3, "success": 4, "skipped": 4}
rows.sort(key=lambda r: (RANK.get(r[1], 2), r[0]))
if BAD_ONLY:
    rows = [r for r in rows if RANK.get(r[1], 2) < 4]

MARK = {"success": "ok", "failure": "FAIL", "none": " --", "cancelled": "cxl"}
print(f"{'':4} {'repo':<22} {'result':<9} {'age':>4}  {'workflow':<20} branch")
for name, concl, a, wf, br, url in rows:
    print(f"{MARK.get(concl, '  ?'):>4} {name:<22} {concl:<9} {a:>4}  {wf:<20} {br}")

n = len(rows)
bad = sum(1 for r in rows if RANK.get(r[1], 2) == 0)
none = sum(1 for r in rows if r[1] == "none")
ok = sum(1 for r in rows if r[1] == "success")
print(f"\n{n} repos · {ok} green · {bad} failing · {none} with no CI configured")
for name, concl, a, wf, br, url in rows:
    if RANK.get(concl, 2) == 0:
        print(f"  {name}: {url}")
